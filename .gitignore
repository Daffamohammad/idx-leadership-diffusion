# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
coverage.xml

# Data (keep directory structure, ignore large/raw artifacts)
data/raw/*
data/normalized/*
data/snapshots/*
data/cache/*
!data/raw/.gitkeep
!data/normalized/.gitkeep
!data/snapshots/.gitkeep
!data/cache/.gitkeep
data/fixtures/*.parquet
!data/fixtures/.gitkeep

# Logs
logs/
*.log

# Misc
*.bak
*.tmp

# Web app (Vite/React)
app/web/node_modules/
app/web/dist/
app/web/.vite/
app/web/.figma/
app/web/tsconfig.tsbuildinfo
app/web/public/snapshots/*.json
!app/web/public/snapshots/.gitkeep
# Keep the sanitized payloads used by the checked-in SPA contract tests and
# the default static preview. Other generated exports remain ignored.
!app/web/public/snapshots/index.json
!app/web/public/snapshots/snap_sectors_2026-08-27.json
!app/web/public/snapshots/yf_harness_2026-08-28_adj.json
